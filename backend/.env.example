# Copy to .env for local development. Never commit real secrets.
ENVIRONMENT=development
# PostgreSQL recommended; SQLite works for a quick start:
# DATABASE_URL=sqlite:///./dev.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/marketplace
SECRET_KEY=replace-with-64-random-characters-from-python-secrets-token-urlsafe
CORS_ORIGINS=["http://localhost:3000"]
PUBLIC_WEB_URL=http://localhost:3000
COOKIE_SECURE=false

# Branding (final name/domain TBD; change here without touching code)
BRAND_NAME=Lumen & Reel
BRAND_TAGLINE=Licensed photography, footage and production talent worldwide.
BRAND_DOMAIN=localhost:3000
BRAND_SUPPORT_EMAIL=support@example.com

# Storage: local (dev) or s3 (any S3-compatible provider such as Cloudflare R2)
STORAGE_BACKEND=local
# S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PRIVATE_BUCKET=media-originals
# S3_PUBLIC_BUCKET=media-previews
# PUBLIC_MEDIA_BASE_URL=https://media.example.com

# Malware scanning: none (dev only) or clamav (set CLAMD_HOST / CLAMD_PORT)
MALWARE_SCANNER=none

# Email: console (logs links) or smtp (set SMTP_HOST, SMTP_PORT, SMTP_USERNAME, SMTP_PASSWORD)
EMAIL_BACKEND=console

# Payments: "fake" simulates checkout locally (no money moves; refused in production).
# "stripe" uses Stripe Checkout + Connect Express (see docs/DEPLOYMENT.md).
PAYMENT_PROVIDER=fake
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_TAX_ENABLED=false
EARNINGS_HOLD_DAYS=14
MIN_PAYOUT_CENTS=1000
REFERRAL_ATTRIBUTION_DAYS=365

# Stay off until agreements are counsel-approved and payments are tested.
# Set FEATURE_PAID_LICENSING=true locally to try checkout with the fake provider.
FEATURE_PAID_LICENSING=false
FEATURE_EXCLUSIVE_LICENSING=false
